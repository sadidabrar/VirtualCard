<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= card.full_name %> — Digital Business Card</title>
  <link rel="stylesheet" href="/css/glass.css">
  <style>
    :root {
      --accent: <%= card.theme || '#38bdf8' %>;
      --accent-glow: color-mix(in srgb, var(--accent) 40%, transparent);
    }

    .tenant-viewport {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
    }
  </style>
</head>
<body>
  <!-- Ambient Dynamic Glass Background -->
  <div class="aurora-bg">
    <div class="aurora-blob aurora-blob-1"></div>
    <div class="aurora-blob aurora-blob-2"></div>
    <div class="aurora-blob aurora-blob-3"></div>
  </div>
  <div class="noise-overlay"></div>

  <main class="tenant-viewport">
    <div class="vcard-preview-card glass-enter">
      <!-- Avatar -->
      <div class="vcard-avatar-wrap">
        <% if (card.avatar_url) { %>
          <img class="vcard-avatar-img" src="<%= card.avatar_url %>" alt="<%= card.full_name %>">
        <% } else { %>
          <img class="vcard-avatar-img" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0%25' y1='0%25' x2='100%25' y2='100%25'%3E%3Cstop offset='0%25' stop-color='%2338bdf8'/%3E%3Cstop offset='100%25' stop-color='%231e3a8a'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='100' height='100' fill='url(%23g)'/%3E%3Ccircle cx='50' cy='38' r='18' fill='%23ffffff'/%3E%3Cpath d='M25 80c0-14 11-24 25-24s25 10 25 24' fill='%23ffffff'/%3E%3C/svg%3E" alt="Avatar">
        <% } %>
      </div>

      <h1 class="vcard-name"><%= card.full_name %></h1>
      <div class="vcard-role"><%= card.job_title %></div>
      <div class="vcard-company"><%= card.company %></div>

      <% if (card.tagline) { %>
        <div class="vcard-tagline"><%= card.tagline %></div>
      <% } %>

      <div class="vcard-actions">
        <% if (card.phone) { %>
          <a href="tel:<%= card.phone %>" class="glass-pill glass-btn-primary" style="justify-content: center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call <%= card.phone %>
          </a>
        <% } %>
        <% if (card.public_email) { %>
          <a href="mailto:<%= card.public_email %>" class="glass-pill glass-btn-secondary" style="justify-content: center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Email Contact
          </a>
        <% } %>
      </div>

      <div style="margin-top: 1.75rem; font-size: 0.75rem; color: var(--text-dim);">
        Subdomain: <strong style="color: var(--accent);"><%= tenant %>.virtualcard.duckdns.org</strong>
      </div>
      <div style="margin-top: 0.5rem; font-size: 0.75rem; color: var(--text-dim);">
        Powered by <a href="/" style="color: var(--accent); text-decoration: underline;">virtualcard.duckdns.org</a>
      </div>
    </div>
  </main>
</body>
</html>
