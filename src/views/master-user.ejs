<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage @<%= targetUser.username %> — Master Admin</title>
  <link rel="stylesheet" href="/css/glass.css">
  <style>
    :root {
      --accent: <%= (targetCard && targetCard.theme) || '#38bdf8' %>;
      --accent-glow: color-mix(in srgb, var(--accent) 40%, transparent);
    }
  </style>
</head>
<body>
  <%- include('partials/bg') %>
  <%- include('partials/nav') %>

  <main class="page-container">
    <header class="editor-header-bar glass-enter delay-1">
      <div>
        <div style="display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap; margin-bottom: 0.5rem;">
          <a href="/master" class="glass-pill glass-btn-secondary" style="padding: 0.35rem 0.8rem; font-size: 0.78rem;">
            &larr; Back to Directory
          </a>
          <span class="status-pill <%= targetUser.role === 'master' ? 'status-pill-master' : 'status-pill-neutral' %>">
            <%= targetUser.role %>
          </span>
          <span class="status-pill <%= targetUser.status === 'active' ? 'status-pill-active' : 'status-pill-suspended' %>">
            <%= targetUser.status %>
          </span>
        </div>
        <h1 style="font-size: clamp(1.55rem, 3vw, 2.2rem); margin-bottom: 0.25rem;">
          Manage @<%= targetUser.username %>
        </h1>
        <p style="font-size: 0.9rem;">
          User ID #<%= targetUser.id %> · Subdomain:
          <a href="<%= publicCardHref %>" target="_blank" rel="noopener noreferrer"><%= canonicalUrl %></a>
        </p>
      </div>

      <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
        <a href="<%= publicCardHref %>" target="_blank" rel="noopener noreferrer" class="glass-pill glass-btn-primary">
          View Public Card
        </a>
      </div>
    </header>

    <% if (errors && errors.length > 0) { %>
      <div class="glass-alert glass-alert-error" role="alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0; margin-top:2px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <div>
          <% errors.forEach(function(err) { %>
            <div><%= err %></div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <% if (toastMessage) { %>
      <div class="glass-alert glass-alert-success" role="status">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0; margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>
        <div><%= toastMessage %></div>
      </div>
    <% } %>

    <div class="master-detail-grid">
      <!-- Left Column: Account & Card Unified Edit Form -->
      <form method="POST" action="/master/users/<%= targetUser.id %>" class="editor-main-stack glass-enter delay-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <section class="glass-panel">
          <div class="editor-section-head">
            <h2>Account Settings</h2>
            <span class="glass-label-sub">Username: @<%= targetUser.username %></span>
          </div>

          <div class="glass-form-group">
            <label class="glass-label" for="admin-email">Account Email</label>
            <input
              class="glass-input"
              id="admin-email"
              name="email"
              type="email"
              value="<%= targetUser.email %>"
              required
            >
          </div>

          <div class="form-grid-2">
            <div class="glass-form-group" style="margin-bottom: 0;">
              <label class="glass-label" for="admin-role">Role</label>
              <select class="glass-input glass-select" id="admin-role" name="role">
                <option value="owner" <%= targetUser.role === 'owner' ? 'selected' : '' %>>owner</option>
                <option value="master" <%= targetUser.role === 'master' ? 'selected' : '' %>>master</option>
              </select>
            </div>

            <div class="glass-form-group" style="margin-bottom: 0;">
              <label class="glass-label" for="admin-status">Account Status</label>
              <select class="glass-input glass-select" id="admin-status" name="status">
                <option value="active" <%= targetUser.status === 'active' ? 'selected' : '' %>>active</option>
                <option value="suspended" <%= targetUser.status === 'suspended' ? 'selected' : '' %>>suspended</option>
              </select>
            </div>
          </div>
        </section>

        <section class="glass-panel">
          <div class="editor-section-head">
            <h2>Digital Card Content</h2>
            <span class="glass-label-sub">Edit any field on this user's business card</span>
          </div>

          <div class="form-grid-2">
            <div class="glass-form-group">
              <label class="glass-label" for="admin-full-name">Full Name *</label>
              <input
                class="glass-input"
                id="admin-full-name"
                name="full_name"
                type="text"
                value="<%= (targetCard && targetCard.full_name) || '' %>"
                required
                minlength="2"
                maxlength="100"
              >
            </div>

            <div class="glass-form-group">
              <label class="glass-label" for="admin-job-title">Job Title</label>
              <input
                class="glass-input"
                id="admin-job-title"
                name="job_title"
                type="text"
                value="<%= (targetCard && targetCard.job_title) || '' %>"
                maxlength="100"
              >
            </div>
          </div>

          <div class="form-grid-2">
            <div class="glass-form-group">
              <label class="glass-label" for="admin-company">Company</label>
              <input
                class="glass-input"
                id="admin-company"
                name="company"
                type="text"
                value="<%= (targetCard && targetCard.company) || '' %>"
                maxlength="100"
              >
            </div>

            <div class="glass-form-group">
              <label class="glass-label" for="admin-address">Address</label>
              <input
                class="glass-input"
                id="admin-address"
                name="address"
                type="text"
                value="<%= (targetCard && targetCard.address) || '' %>"
                maxlength="200"
              >
            </div>
          </div>

          <div class="glass-form-group">
            <label class="glass-label" for="admin-tagline">Tagline / Bio</label>
            <input
              class="glass-input"
              id="admin-tagline"
              name="tagline"
              type="text"
              value="<%= (targetCard && targetCard.tagline) || '' %>"
              maxlength="200"
            >
          </div>

          <div class="form-grid-2">
            <div class="glass-form-group">
              <label class="glass-label" for="admin-phone">Phone</label>
              <input
                class="glass-input"
                id="admin-phone"
                name="phone"
                type="tel"
                value="<%= (targetCard && targetCard.phone) || '' %>"
                maxlength="32"
              >
            </div>

            <div class="glass-form-group">
              <label class="glass-label" for="admin-whatsapp">WhatsApp</label>
              <input
                class="glass-input"
                id="admin-whatsapp"
                name="whatsapp"
                type="tel"
                value="<%= (targetCard && targetCard.whatsapp) || '' %>"
                maxlength="32"
              >
            </div>
          </div>

          <div class="form-grid-2">
            <div class="glass-form-group">
              <label class="glass-label" for="admin-public-email">Public Email</label>
              <input
                class="glass-input"
                id="admin-public-email"
                name="public_email"
                type="email"
                value="<%= (targetCard && targetCard.public_email) || '' %>"
              >
            </div>

            <div class="glass-form-group">
              <label class="glass-label" for="admin-website">Website</label>
              <input
                class="glass-input"
                id="admin-website"
                name="website"
                type="url"
                value="<%= (targetCard && targetCard.website) || '' %>"
              >
            </div>
          </div>

          <div class="glass-form-group">
            <span class="glass-label">Accent Tint</span>
            <div class="accent-swatch-row">
              <% const currentTheme = (targetCard && targetCard.theme) || '#38bdf8'; %>
              <% accentPresets.forEach(function(preset) { %>
                <label class="accent-radio-label" title="<%= preset.name %>">
                  <input
                    type="radio"
                    name="theme"
                    value="<%= preset.hex %>"
                    <%= currentTheme.toLowerCase() === preset.hex.toLowerCase() ? 'checked' : '' %>
                  >
                  <span class="accent-swatch-circle" style="background: <%= preset.hex %>;"></span>
                </label>
              <% }); %>
            </div>
          </div>

          <div class="glass-form-group" style="margin-bottom: 0;">
            <label class="glass-toggle-wrap" for="admin-is-published">
              <input
                type="checkbox"
                id="admin-is-published"
                name="is_published"
                value="true"
                <%= (!targetCard || targetCard.is_published) ? 'checked' : '' %>
              >
              <span class="glass-toggle" aria-hidden="true">
                <span class="glass-toggle-thumb"></span>
              </span>
              <span style="font-size: 0.9rem; font-weight: 600;">Card Published</span>
            </label>
          </div>
        </section>

        <section class="glass-panel">
          <div class="editor-section-head">
            <h2>Social Profiles</h2>
            <span class="glass-label-sub">Valid https:// or http:// links</span>
          </div>

          <input
            type="hidden"
            id="social-order-input"
            name="social_order"
            value="<%= orderedSocials.map(function(s) { return s.platform; }).join(',') %>"
          >

          <div class="form-grid-2">
            <% orderedSocials.forEach(function(s) { %>
              <div class="glass-form-group" style="margin-bottom: 0.5rem;">
                <label class="glass-label" for="admin-social-<%= s.platform %>"><%= s.label %></label>
                <input
                  class="glass-input"
                  id="admin-social-<%= s.platform %>"
                  name="social_<%= s.platform %>"
                  type="url"
                  value="<%= s.url %>"
                  placeholder="<%= s.placeholder %>"
                >
              </div>
            <% }); %>
          </div>
        </section>

        <div class="editor-sticky-save">
          <span style="font-size: 0.85rem; color: var(--text-muted);">
            Save account &amp; card changes for <strong>@<%= targetUser.username %></strong>
          </span>
          <button type="submit" class="glass-pill glass-btn-primary">Save All Changes</button>
        </div>
      </form>

      <!-- Right Column: Moderation Tools, QR Preview & Danger Zone -->
      <aside class="editor-main-stack glass-enter delay-3">
        <!-- QR Summary -->
        <section class="glass-panel" style="text-align: center;">
          <h2 style="font-size: 1.05rem; margin-bottom: 0.85rem;">Subdomain QR Code</h2>
          <div style="display: flex; justify-content: center; margin-bottom: 0.85rem;">
            <div class="solid-qr-card" style="padding: 0.65rem; border-radius: 12px;">
              <img src="<%= qrDataUrl %>" alt="QR Code for <%= targetUser.username %>" width="120" height="120" style="display: block;">
            </div>
          </div>
          <div style="display: flex; gap: 0.5rem;">
            <a href="<%= qrPngHref %>" class="glass-pill glass-btn-secondary" style="flex: 1; justify-content: center; font-size: 0.8rem;" download>PNG QR</a>
            <a href="<%= qrSvgHref %>" class="glass-pill glass-btn-secondary" style="flex: 1; justify-content: center; font-size: 0.8rem;" download>SVG QR</a>
          </div>
        </section>

        <!-- Suspend / Reactivate Card -->
        <% if (targetUser.role !== 'master') { %>
          <section class="glass-panel">
            <div class="editor-section-head">
              <h2>Account Access</h2>
            </div>
            <p style="font-size: 0.85rem; margin-bottom: 1rem;">
              <% if (targetUser.status === 'active') { %>
                Suspending immediately takes this user's public card offline (404) and invalidates active login sessions.
              <% } else { %>
                This account is currently suspended. Reactivating restores login access and public card availability.
              <% } %>
            </p>
            <form method="POST" action="/master/users/<%= targetUser.id %>/status">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="redirect_to" value="detail">
              <input type="hidden" name="status" value="<%= targetUser.status === 'active' ? 'suspended' : 'active' %>">
              <button
                type="submit"
                class="glass-pill <%= targetUser.status === 'active' ? 'glass-btn-danger' : 'glass-btn-primary' %>"
                style="width: 100%; justify-content: center;"
              >
                <%= targetUser.status === 'active' ? 'Suspend Account' : 'Reactivate Account' %>
              </button>
            </form>
          </section>
        <% } %>

        <!-- Password Reset -->
        <section class="glass-panel">
          <div class="editor-section-head">
            <h2>Reset Password</h2>
          </div>
          <form method="POST" action="/master/users/<%= targetUser.id %>/reset-password" id="reset-password-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="glass-form-group">
              <label class="glass-label" for="reset-new-password">New Password <span class="glass-label-sub">(min 8 chars)</span></label>
              <input
                class="glass-input"
                id="reset-new-password"
                name="new_password"
                type="password"
                required
                minlength="8"
                maxlength="128"
                autocomplete="new-password"
              >
            </div>
            <div class="glass-form-group" style="margin-bottom: 0.45rem;">
              <label class="glass-label" for="reset-confirm-password">Confirm Password</label>
              <input
                class="glass-input"
                id="reset-confirm-password"
                name="confirm_password"
                type="password"
                required
                minlength="8"
                maxlength="128"
                autocomplete="new-password"
              >
            </div>
            <div class="availability-hint" id="reset-password-match-hint" aria-live="polite" style="margin-bottom: 1rem;"></div>
            <button type="submit" class="glass-pill glass-btn-secondary" style="width: 100%; justify-content: center;">
              Update User Password
            </button>
          </form>
        </section>

        <!-- Danger Zone -->
        <% if (targetUser.role !== 'master') { %>
          <section class="glass-panel" style="border-color: rgba(244, 63, 94, 0.35);">
            <div class="editor-section-head" style="border-bottom-color: rgba(244, 63, 94, 0.2);">
              <h2 style="color: #fecdd3;">Danger Zone</h2>
            </div>
            <p style="font-size: 0.84rem; margin-bottom: 1rem; color: var(--text-muted);">
              Permanently delete <strong>@<%= targetUser.username %></strong>, their business card, and uploaded media.
            </p>
            <form
              method="POST"
              action="/master/users/<%= targetUser.id %>/delete"
              class="master-delete-form"
              data-delete-user-id="<%= targetUser.id %>"
              data-delete-username="<%= targetUser.username %>"
            >
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="glass-pill glass-btn-danger" style="width: 100%; justify-content: center;">
                Delete User Permanently
              </button>
            </form>
          </section>
        <% } %>
      </aside>
    </div>
  </main>

  <!-- Liquid Glass Delete Confirmation Modal -->
  <dialog class="glass-modal" id="delete-confirm-modal" aria-labelledby="delete-modal-title">
    <h2 id="delete-modal-title" style="font-size: 1.25rem; margin-bottom: 0.65rem;">Delete User Account?</h2>
    <p style="font-size: 0.9rem; margin-bottom: 1.35rem; color: var(--text-muted);">
      This will permanently remove <strong id="delete-modal-username" style="color: var(--text-main);"></strong>,
      delete their digital business card and avatar, and release their subdomain.
    </p>
    <div id="delete-modal-error" class="availability-hint availability-err" style="margin-bottom: 0.85rem;"></div>
    <div style="display: flex; justify-content: flex-end; gap: 0.75rem; flex-wrap: wrap;">
      <button type="button" class="glass-pill glass-btn-secondary" id="delete-modal-cancel">Cancel</button>
      <button type="button" class="glass-pill glass-btn-danger" id="delete-modal-confirm">Delete Permanently</button>
    </div>
  </dialog>

  <div
    class="glass-toast"
    id="master-toast"
    role="status"
    aria-live="polite"
    data-toast-message="<%= toastMessage || '' %>"
    data-csrf-token="<%= csrfToken %>"
  ><%= toastMessage || '' %></div>

  <script src="/js/master.js" defer></script>
</body>
</html>
