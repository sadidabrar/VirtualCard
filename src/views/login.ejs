<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Log In — VirtualCard</title>
  <%- include('partials/favicon') %>
  <link rel="stylesheet" href="/css/glass.css">
</head>
<body>
  <%- include('partials/bg') %>
  <%- include('partials/nav') %>

  <main class="page-container-narrow">
    <div class="glass-panel glass-enter">
      <div style="margin-bottom: 1rem;">
        <span class="glass-badge">
          <span class="glass-badge-dot"></span>
          Account Access
        </span>
      </div>
      <h1 style="font-size: 1.85rem; margin-bottom: 0.4rem;">Welcome Back</h1>
      <p style="font-size: 0.925rem; margin-bottom: 1.75rem;">
        Sign in to manage your digital business card and QR code.
      </p>

      <% if (error) { %>
        <div class="glass-alert glass-alert-error" role="alert">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0; margin-top:2px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="glass-form-group">
          <label class="glass-label" for="login-identifier">Username or Email</label>
          <input
            class="glass-input"
            id="login-identifier"
            name="identifier"
            type="text"
            value="<%= formData.identifier || '' %>"
            placeholder="mahbubkhan or name@example.com"
            required
            autocomplete="username"
            autocapitalize="none"
          >
        </div>

        <div class="glass-form-group">
          <label class="glass-label" for="login-password">Password</label>
          <input
            class="glass-input"
            id="login-password"
            name="password"
            type="password"
            placeholder="Enter your password"
            required
            autocomplete="current-password"
          >
        </div>

        <button type="submit" class="glass-pill glass-btn-primary" style="width: 100%; justify-content: center; margin-top: 0.5rem;">
          Sign In
        </button>
      </form>

      <div style="margin-top: 1.5rem; text-align: center; font-size: 0.875rem; color: var(--text-muted);">
        Don't have a card yet? <a href="/signup" style="color: var(--accent); font-weight: 600; text-decoration: underline;">Create yours now</a>
      </div>
    </div>
  </main>
</body>
</html>
