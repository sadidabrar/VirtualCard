<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= card.full_name %> — VirtualCard</title>
  <meta name="description" content="<%= ogDescription %>">

  <!-- Open Graph & Social Sharing Tags -->
  <meta property="og:type" content="profile">
  <meta property="og:title" content="<%= card.full_name %><%= card.job_title ? ' — ' + card.job_title : '' %>">
  <meta property="og:description" content="<%= ogDescription %>">
  <meta property="og:image" content="<%= ogImageUrl %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= card.full_name %>">
  <meta name="twitter:description" content="<%= ogDescription %>">

  <%- include('partials/favicon') %>
  <link rel="stylesheet" href="/css/glass.css?v=2.1.0">
  <style>
    :root {
      --accent: <%= card.theme || '#38bdf8' %>;
      --accent-glow: color-mix(in srgb, var(--accent) 42%, transparent);
    }

    .public-card-viewport {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem 3rem;
      gap: 1.25rem;
    }

    .public-card-shell {
      width: 100%;
      max-width: 460px;
      padding: 2.75rem 1.85rem 2rem;
    }

    .owner-bar {
      width: 100%;
      max-width: 460px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      flex-wrap: wrap;
      padding: 0.65rem 1rem;
      border-radius: var(--radius-pill);
      background: rgba(14, 16, 24, 0.78);
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-inner-highlight), 0 8px 24px rgba(0, 0, 0, 0.45);
      font-size: 0.825rem;
    }

    /* Corner QR Glass Badge (<details> works without JS too) */
    .qr-corner-details {
      position: absolute;
      top: 1.15rem;
      right: 1.15rem;
      z-index: 20;
    }

    .qr-corner-summary {
      list-style: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.35rem;
      border-radius: 14px;
      background: rgba(12, 14, 22, 0.68);
      border: 1px solid rgba(255, 255, 255, 0.22);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 6px 18px rgba(0, 0, 0, 0.45);
      transition: transform var(--motion-fast), border-color var(--motion-fast), box-shadow var(--motion-fast);
    }

    .qr-corner-summary::-webkit-details-marker {
      display: none;
    }

    .qr-corner-summary:hover {
      transform: translateY(-2px) scale(1.04);
      border-color: var(--accent);
      box-shadow: 0 0 18px var(--accent-glow);
    }

    .qr-mini-white {
      background: #ffffff;
      padding: 3px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .qr-popover {
      position: absolute;
      top: calc(100% + 0.6rem);
      right: 0;
      width: 248px;
      padding: 1.15rem;
      border-radius: var(--radius-lg);
      background: rgba(14, 16, 24, 0.94);
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
      border: 1px solid rgba(255, 255, 255, 0.24);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 20px 50px rgba(0, 0, 0, 0.78);
      text-align: center;
    }

    .vcard-address-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 1.25rem;
      padding: 0.3rem 0.75rem;
      border-radius: var(--radius-pill);
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .vcard-action-pill {
      justify-content: center;
      width: 100%;
    }
  </style>
</head>
<body>
  <%- include('partials/bg') %>

  <main class="public-card-viewport">
    <% if (isOwner) { %>
      <div class="owner-bar glass-enter">
        <span style="display: inline-flex; align-items: center; gap: 0.45rem; color: var(--text-muted);">
          <span class="glass-badge-dot"></span>
          <% if (!card.is_published) { %>
            Unpublished Draft (Private)
          <% } else { %>
            Your Public Card
          <% } %>
        </span>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          <a href="<%= editHref %>" class="glass-pill glass-btn-primary" style="padding: 0.35rem 0.9rem; font-size: 0.8rem;">
            Edit Card
          </a>
          <a href="<%= vaultHref %>" class="glass-pill glass-btn-secondary" style="padding: 0.35rem 0.9rem; font-size: 0.8rem;">
            Private Vault
          </a>
        </div>
      </div>
    <% } %>

    <!-- Centerpiece Liquid Glass Card -->
    <article class="vcard-preview-card public-card-shell glass-enter delay-1" id="public-card-panel">
      <!-- Corner QR Badge (Solid White QR inside Glass Frame) -->
      <details class="qr-corner-details" id="qr-corner-details">
        <summary class="qr-corner-summary" aria-label="Show QR Code &amp; Download Options" title="QR Code">
          <span class="qr-mini-white">
            <img src="<%= qrDataUrl %>" alt="Mini QR code" width="34" height="34">
          </span>
        </summary>
        <div class="qr-popover">
          <div style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.65rem;">
            Scan to Open Card
          </div>
          <div class="solid-qr-card" style="padding: 0.75rem;">
            <img src="<%= qrDataUrl %>" alt="QR Code for <%= canonicalUrl %>" width="160" height="160">
          </div>
          <div style="margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.45rem;">
            <a href="<%= qrPngHref %>" class="glass-pill glass-btn-secondary" download="<%= tenant %>-card.png" style="justify-content: center; padding: 0.4rem 0.75rem; font-size: 0.78rem;">
              Download PNG (2048px)
            </a>
            <a href="<%= qrSvgHref %>" class="glass-pill glass-btn-secondary" download="<%= tenant %>-card.svg" style="justify-content: center; padding: 0.4rem 0.75rem; font-size: 0.78rem;">
              Download SVG
            </a>
            <button type="button" class="glass-pill glass-btn-secondary" id="copy-card-link-btn" data-copy-url="<%= canonicalUrl %>" style="justify-content: center; padding: 0.4rem 0.75rem; font-size: 0.78rem;">
              Copy Card URL
            </button>
          </div>
        </div>
      </details>

      <!-- Avatar -->
      <div class="vcard-avatar-wrap">
        <% if (card.avatar_url) { %>
          <img class="vcard-avatar-img" src="<%= card.avatar_url %>" alt="<%= card.full_name %>">
        <% } else { %>
          <img class="vcard-avatar-img" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0%25' y1='0%25' x2='100%25' y2='100%25'%3E%3Cstop offset='0%25' stop-color='%2338bdf8'/%3E%3Cstop offset='100%25' stop-color='%231e3a8a'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='100' height='100' fill='url(%23g)'/%3E%3Ccircle cx='50' cy='38' r='18' fill='%23ffffff'/%3E%3Cpath d='M25 80c0-14 11-24 25-24s25 10 25 24' fill='%23ffffff'/%3E%3C/svg%3E" alt="<%= card.full_name %>">
        <% } %>
      </div>

      <!-- Identity -->
      <h1 class="vcard-name" style="font-size: 1.7rem;"><%= card.full_name %></h1>
      <% if (card.job_title) { %>
        <div class="vcard-role"><%= card.job_title %></div>
      <% } %>
      <% if (card.company) { %>
        <div class="vcard-company"><%= card.company %></div>
      <% } %>
      <% if (card.address || resolvedMapsUrl) { %>
        <div class="vcard-address-chip">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <% if (card.address) { %><span><%= card.address %></span><% } %>
          <% if (resolvedMapsUrl) { %>
            <a href="<%= resolvedMapsUrl %>" target="_blank" rel="noopener noreferrer" style="color: var(--accent); font-weight: 700; text-decoration: underline;">
              Google Maps
            </a>
          <% } %>
        </div>
      <% } %>
      <% if (card.tagline) { %>
        <div class="vcard-tagline"><%= card.tagline %></div>
      <% } %>

      <!-- Action Buttons: Save Contact / Primary Call / Phone Lines / WhatsApp / Email / Website -->
      <div class="vcard-actions">
        <a href="<%= vcardHref %>" download="<%= tenant %>.vcf" class="glass-pill glass-btn-primary vcard-action-pill">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Save Contact to Phone (.vcf)
        </a>

        <% if (phoneEntries && phoneEntries.length > 0) { %>
          <div class="vcard-phone-list" aria-label="Phone Numbers">
            <% phoneEntries.forEach(function(p) { %>
              <div class="vcard-phone-item">
                <div class="vcard-phone-meta">
                  <span class="vcard-phone-label"><%= p.label %></span>
                  <span class="vcard-phone-num"><%= p.number %></span>
                </div>
                <div class="vcard-phone-btns">
                  <a href="tel:<%= p.number %>" class="mini-action-pill mini-action-pill-accent" aria-label="Call <%= p.number %>">Call</a>
                  <a href="<%= p.saveVcfHref %>" download="<%= tenant %>-phone-<%= p.index + 1 %>.vcf" class="mini-action-pill" aria-label="Save <%= p.number %> to phone">Save #</a>
                  <% if (p.whatsappUrl) { %>
                    <a href="<%= p.whatsappUrl %>" target="_blank" rel="noopener noreferrer" class="mini-action-pill">WhatsApp</a>
                  <% } %>
                  <button type="button" class="mini-action-pill" data-copy-text="<%= p.number %>" aria-label="Copy <%= p.number %>">Copy</button>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else if (card.phone) { %>
          <a href="tel:<%= card.phone %>" class="glass-pill glass-btn-secondary vcard-action-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call <%= card.phone %>
          </a>
        <% } %>

        <% if (whatsappUrl && (!phoneEntries || !phoneEntries.some(function(p) { return p.whatsappUrl; }))) { %>
          <a href="<%= whatsappUrl %>" target="_blank" rel="noopener noreferrer" class="glass-pill glass-btn-secondary vcard-action-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            WhatsApp
          </a>
        <% } %>

        <% if (card.public_email) { %>
          <a href="mailto:<%= card.public_email %>" class="glass-pill glass-btn-secondary vcard-action-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Email
          </a>
        <% } %>

        <% if (websiteUrl) { %>
          <a href="<%= websiteUrl %>" target="_blank" rel="noopener noreferrer" class="glass-pill glass-btn-secondary vcard-action-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
            Visit Website
          </a>
        <% } %>
      </div>

      <!-- Social Icon Row + Additional Social Accounts / Numbers -->
      <% if ((socials && socials.length > 0) || (extraSocials && extraSocials.length > 0)) { %>
        <% if (socials && socials.length > 0) { %>
          <div class="vcard-socials-row" aria-label="Social Links">
            <% socials.forEach(function(item) { %>
              <a
                href="<%= item.url %>"
                target="_blank"
                rel="noopener noreferrer"
                class="vcard-social-icon"
                aria-label="<%= item.platform %>"
                title="<%= item.platform %>"
              >
                <% if (item.platform === 'linkedin') { %>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                <% } else if (item.platform === 'github') { %>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/></svg>
                <% } else if (item.platform === 'x') { %>
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>
                <% } else if (item.platform === 'instagram') { %>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                <% } else if (item.platform === 'facebook') { %>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                <% } else if (item.platform === 'telegram') { %>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                <% } else if (item.platform === 'youtube') { %>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3v6Z"/></svg>
                <% } %>
              </a>
            <% }); %>
          </div>
        <% } %>

        <% if (extraSocials && extraSocials.length > 0) { %>
          <div class="vcard-extra-socials" aria-label="Additional Accounts and Numbers">
            <% extraSocials.forEach(function(item) { %>
              <% if (item.href) { %>
                <a
                  href="<%= item.href %>"
                  <%= /^https?:\/\//i.test(item.href) ? 'target="_blank" rel="noopener noreferrer"' : '' %>
                  class="vcard-extra-chip"
                >
                  <strong style="color: var(--accent);"><%= item.label %>:</strong>
                  <span><%= item.value %></span>
                </a>
              <% } else { %>
                <button
                  type="button"
                  class="vcard-extra-chip"
                  data-copy-text="<%= item.value %>"
                  title="Tap to copy <%= item.label %>"
                >
                  <strong style="color: var(--accent);"><%= item.label %>:</strong>
                  <span><%= item.value %></span>
                </button>
              <% } %>
            <% }); %>
          </div>
        <% } %>
      <% } %>

      <!-- Subtle Footer -->
      <footer style="margin-top: 2rem; font-size: 0.76rem; color: var(--text-dim);">
        Powered by <a href="<%= rootHomeHref %>" style="color: var(--accent); text-decoration: underline;"><%= baseDomain %></a>
      </footer>
    </article>
  </main>

  <div class="glass-toast" id="card-toast" role="status" aria-live="polite">Card link copied!</div>
  <script src="/js/public-card.js" defer></script>
</body>
</html>
