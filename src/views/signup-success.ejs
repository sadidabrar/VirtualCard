<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Your Card Is Live! — VirtualCard</title>
  <%- include('partials/favicon') %>
  <link rel="stylesheet" href="/css/glass.css?v=2.1.0">
  <style>
    :root {
      --accent: <%= theme || '#38bdf8' %>;
      --accent-glow: color-mix(in srgb, var(--accent) 40%, transparent);
    }

    .success-card {
      max-width: 680px;
      margin: 2rem auto 4rem;
      text-align: center;
    }

    .public-url-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      justify-content: center;
      padding: 0.55rem 0.65rem 0.55rem 1.25rem;
      border-radius: var(--radius-pill);
      background: rgba(12, 14, 22, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.18);
      margin: 1.5rem 0;
      max-width: 100%;
    }

    .public-url-link {
      color: var(--accent);
      font-weight: 600;
      font-size: 0.95rem;
      word-break: break-all;
      text-decoration: underline;
    }

    .action-grid {
      display: flex;
      gap: 0.85rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 1.75rem;
    }
  </style>
</head>
<body>
  <%- include('partials/bg') %>
  <%- include('partials/nav') %>

  <main class="page-container">
    <div class="glass-panel success-card glass-enter">
      <div style="margin-bottom: 0.85rem;">
        <span class="glass-badge">
          <span class="glass-badge-dot"></span>
          Subdomain Provisioned
        </span>
      </div>

      <h1 style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); margin-bottom: 0.5rem;">Your Virtual Card Is Live!</h1>
      <p style="font-size: 0.975rem; max-width: 520px; margin: 0 auto;">
        Share your personal URL or print your high-resolution QR code to connect instantly.
      </p>

      <!-- Public Link Pill + Copy Button -->
      <div>
        <div class="public-url-pill">
          <a href="<%= clickableCardHref %>" class="public-url-link" id="public-url-text"><%= canonicalUrl %></a>
          <button type="button" class="glass-pill glass-btn-secondary" id="copy-url-btn" data-copy-url="<%= canonicalUrl %>" style="padding: 0.45rem 1rem; font-size: 0.825rem;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <span id="copy-btn-label">Copy Link</span>
          </button>
        </div>
      </div>

      <!-- Rotating Specular Sweep Frame + Solid White QR Card -->
      <div style="margin: 1rem 0 1.5rem;">
        <div class="glass-sweep-wrap">
          <div class="glass-sweep-content">
            <div class="solid-qr-card">
              <img src="<%= qrDataUrl %>" alt="QR code for <%= canonicalUrl %>" width="210" height="210">
            </div>
            <div style="margin-top: 1rem; display: flex; gap: 0.65rem; justify-content: center; flex-wrap: wrap;">
              <a href="<%= qrPngHref %>" class="glass-pill glass-btn-secondary" download="<%= username %>-card.png" style="padding: 0.45rem 1rem; font-size: 0.825rem;">
                Download PNG (2048px)
              </a>
              <a href="<%= qrSvgHref %>" class="glass-pill glass-btn-secondary" download="<%= username %>-card.svg" style="padding: 0.45rem 1rem; font-size: 0.825rem;">
                Download SVG
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Primary Navigation CTAs -->
      <div class="action-grid">
        <a href="<%= clickableCardHref %>" class="glass-pill glass-btn-primary">
          Go to my card
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
        </a>
        <a href="<%= clickableEditorHref %>" class="glass-pill glass-btn-secondary">
          Open my editor
        </a>
      </div>
    </div>
  </main>

  <div class="glass-toast" id="copy-toast" role="status" aria-live="polite">Link copied to clipboard!</div>
  <script src="/js/success.js" defer></script>
</body>
</html>
