<style>
  /* Critical mobile nav rules: inline to guarantee immediate cache-free display */
  @media (max-width: 768px) {
    .glass-nav-links { display: none !important; }
    .glass-nav-mobile { display: block !important; position: relative !important; }
  }
  @media (min-width: 769px) {
    .glass-nav-mobile { display: none !important; }
  }
  .glass-nav-mobile summary {
    list-style: none !important;
  }
  .glass-nav-mobile summary::-webkit-details-marker,
  .glass-nav-mobile summary::marker {
    display: none !important;
    content: "" !important;
    font-size: 0 !important;
  }
  .glass-nav-mobile:not([open]) .icon-menu-close {
    display: none !important;
  }
  .glass-nav-mobile:not([open]) .icon-menu-open {
    display: block !important;
  }
  .glass-nav-mobile[open] .icon-menu-open {
    display: none !important;
  }
  .glass-nav-mobile[open] .icon-menu-close {
    display: block !important;
  }
</style>
<div class="glass-nav-wrap">
  <nav class="glass-nav" aria-label="Main Navigation">
    <a href="/" class="glass-brand">
      <%- include('brand-mark') %>
      <span>VirtualCard</span>
    </a>

    <!-- Desktop Navigation Links -->
    <div class="glass-nav-links">
      <a href="/demo" class="glass-pill glass-btn-secondary" style="padding: 0.45rem 0.95rem; font-size: 0.85rem;">Live Preview</a>

      <% if (currentUser) { %>
        <% if (currentUser.role === 'master') { %>
          <a href="/master" class="glass-pill glass-btn-secondary" style="padding: 0.45rem 0.95rem; font-size: 0.85rem;">Master Panel</a>
        <% } %>
        <a href="<%= myCardHref %>" class="glass-pill glass-btn-secondary" style="padding: 0.45rem 0.95rem; font-size: 0.85rem;">My Card</a>
        <a href="<%= myEditorHref %>" class="glass-pill glass-btn-primary" style="padding: 0.45rem 1rem; font-size: 0.85rem;">Edit Card</a>
        <a href="<%= myVaultHref %>" class="glass-pill glass-btn-secondary" style="padding: 0.45rem 0.95rem; font-size: 0.85rem;">Private Vault</a>
        <form method="POST" action="/logout" style="display: inline; margin: 0;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="glass-pill glass-btn-secondary" style="padding: 0.45rem 0.95rem; font-size: 0.85rem;">Log Out</button>
        </form>
      <% } else { %>
        <a href="/login" class="glass-pill glass-btn-secondary" style="padding: 0.45rem 1rem; font-size: 0.85rem;">Log In</a>
        <a href="/signup" class="glass-pill glass-btn-primary" style="padding: 0.45rem 1.15rem; font-size: 0.85rem;">Get Started</a>
      <% } %>
    </div>

    <!-- Mobile Navigation Toggle & Dropdown -->
    <details class="glass-nav-mobile" aria-label="Mobile Navigation Menu">
      <summary class="glass-nav-toggle-btn" aria-label="Toggle Navigation Menu">
        <svg class="icon-menu-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
        <svg class="icon-menu-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </summary>
      <div class="glass-nav-mobile-dropdown">
        <a href="/demo" class="glass-mobile-nav-item">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
          Live Preview
        </a>
        <% if (currentUser) { %>
          <% if (currentUser.role === 'master') { %>
            <a href="/master" class="glass-mobile-nav-item">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14.93V17a1 1 0 0 1-2 0v-.07A7 7 0 0 1 5.07 11H5a1 1 0 0 1 0-2h.07A7 7 0 0 1 11 5.07V5a1 1 0 0 1 2 0v.07A7 7 0 0 1 18.93 11H19a1 1 0 0 1 0 2h-.07A7 7 0 0 1 13 16.93z"/></svg>
              Master Panel
            </a>
          <% } %>
          <a href="<%= myCardHref %>" class="glass-mobile-nav-item">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
            My Public Card
          </a>
          <a href="<%= myEditorHref %>" class="glass-mobile-nav-item">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            Edit Card
          </a>
          <a href="<%= myVaultHref %>" class="glass-mobile-nav-item">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Private Vault
          </a>
          <div style="border-top: 1px solid rgba(255, 255, 255, 0.1); margin: 0.35rem 0;"></div>
          <form method="POST" action="/logout" style="margin: 0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="glass-mobile-nav-item glass-mobile-nav-logout" style="width: 100%; text-align: left; background: transparent; border: none; cursor: pointer;">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              Log Out
            </button>
          </form>
        <% } else { %>
          <div style="display: flex; gap: 0.5rem; margin-top: 0.25rem;">
            <a href="/login" class="glass-pill glass-btn-secondary" style="flex: 1; justify-content: center; font-size: 0.85rem; padding: 0.55rem 0.75rem;">Log In</a>
            <a href="/signup" class="glass-pill glass-btn-primary" style="flex: 1; justify-content: center; font-size: 0.85rem; padding: 0.55rem 0.75rem;">Get Started</a>
          </div>
        <% } %>
      </div>
    </details>
    <script src="/js/head.js" defer></script>
  </nav>
</div>
